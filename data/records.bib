@article{KulkarniKrishnanSebastian2025,
   colrev_origin                 = {crossref_jissn_15729419.bib/001705;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {author:crossref_jissn_15729419.bib/001705;;
                                    journal:crossref_jissn_15729419.bib/001705;;
