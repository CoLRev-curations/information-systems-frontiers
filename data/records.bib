@article{MarshanNizarIoannouEtAl2025,
   colrev_origin                 = {crossref_jissn_15729419.bib/001793;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {author:crossref_jissn_15729419.bib/001793;;
                                    journal:crossref_jissn_15729419.bib/001793;;
                                    number:crossref_jissn_15729419.bib/001793;;
                                    pages:crossref_jissn_15729419.bib/001793;;
                                    title:crossref_jissn_15729419.bib/001793;;
                                    volume:crossref_jissn_15729419.bib/001793;;
                                    year:crossref_jissn_15729419.bib/001793;;},
   colrev_data_provenance        = {abstract:crossref_jissn_15729419.bib/001793;;
                                    doi:crossref_jissn_15729419.bib/001793;;
                                    language:crossref_jissn_15729419.bib/001793;;
                                    url:crossref_jissn_15729419.bib/001793;;},
   doi                           = {10.1007/S10796-023-10446-X},
   author                        = {Marshan, Alaa and Nizar, Farah Nasreen Mohamed and Ioannou, Athina and Spanaki, Konstantina},
   journal                       = {Information Systems Frontiers},
   title                         = {Comparing Machine Learning and Deep Learning Techniques for Text Analytics: Detecting the Severity of Hate Comments Online},
   year                          = {2025},
   volume                        = {27},
   number                        = {2},
   pages                         = {487--505},
   url                           = {https://link.springer.com/article/10.1007/s10796-023-10446-x},
   abstract                      = {Social media platforms have become an increasingly popular tool for individuals to share their thoughts and opinions with other people. However, very often people tend to misuse social media posting abusive comments. Abusive and harassing behaviours can have adverse effects on people's lives. This study takes a novel approach to combat harassment in online platforms by detecting the severity of abusive comments, that has not been investigated before. The study compares the performance of machine learning models such as Naïve Bayes, Random Forest, and Support Vector Machine, with deep learning models such as Convolutional Neural Network (CNN) and Bi-directional Long Short-Term Memory (Bi-LSTM). Moreover, in this work we investigate the effect of text pre-processing on the performance of the machine and deep learning models, the feature set for the abusive comments was made using unigrams and bigrams for the machine learning models and word embeddings for the deep learning models. The comparison of the models’ performances showed that the Random Forest with bigrams achieved the best overall performance with an accuracy of (0.94), a precision of (0.91), a recall of (0.94), and an F1 score of (0.92). The study develops an efficient model to detect severity of abusive language in online platforms, offering important implications both to theory and practice.},
   language                      = {eng},
}

