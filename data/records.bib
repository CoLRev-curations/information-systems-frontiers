@article{ApicellaArpaiaBarbatoEtAl2025a,
   colrev_origin                 = {crossref_jissn_15729419.bib/001479;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {author:crossref_jissn_15729419.bib/001479;;
                                    journal:crossref_jissn_15729419.bib/001479;;
                                    number:crossref_jissn_15729419.bib/001479;;
