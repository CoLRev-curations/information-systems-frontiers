                                    year:crossref_jissn_15729419.bib/001593;;
                                    volume:generic_field_requirements;missing;
                                    number:generic_field_requirements;missing;},
   colrev_data_provenance        = {abstract:crossref_jissn_15729419.bib/001593;;
                                    doi:crossref_jissn_15729419.bib/001593;;
                                    language:crossref_jissn_15729419.bib/001593;;
                                    url:crossref_jissn_15729419.bib/001593;;},
   doi                           = {10.1007/S10796-025-10588-0},
   author                        = {Panteli, Niki and Nthubu, Boineelo R and Mersinas, Konstantinos},
   journal                       = {Information Systems Frontiers},
   title                         = {Being Responsible in Cybersecurity: A Multi-Layered Perspective},
   year                          = {2025},
   volume                        = {UNKNOWN},
   number                        = {UNKNOWN},
   url                           = {https://link.springer.com/article/10.1007/s10796-025-10588-0},
   abstract                      = {The paper posits that in the increasingly connected digital landscape, there is a growing need to examine the scale and scope of responsible cybersecurity. In an exploratory study that involved qualitative interviews with senior cybersecurity professionals, we identify different layers of responsible cybersecurity that span across techno-centric, human-centric, organizational (intra and inter) and societal centric perspectives. We present these in an onion-shaped framework and show that collectively these diverse perspectives highlight the linked responsibilities of different stakeholders both within and beyond the organization. The study also finds that senior leadership plays a crucial role in fostering responsible cybersecurity across the different layers. Implications for research and practice are discussed.},
   language                      = {eng},
}

@article{PapagiannidisDavlembayeva2022,
   colrev_origin                 = {DBLP.bib/001383;
                                    crossref_jissn_15729419.bib/000135;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000135;;
                                    title:crossref_jissn_15729419.bib/000135;;
                                    year:crossref_jissn_15729419.bib/000135;;
                                    volume:crossref_jissn_15729419.bib/000135;;
                                    number:crossref_jissn_15729419.bib/000135;;
                                    pages:crossref_jissn_15729419.bib/000135;;
                                    author:crossref_jissn_15729419.bib/000135;;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000135;;
                                    abstract:crossref_jissn_15729419.bib/000135;;
                                    language:crossref_jissn_15729419.bib/000135;;
                                    url:crossref_jissn_15729419.bib/000135;;
                                    colrev.dblp.dblp_key:DBLP.bib/001383|rename-from:dblp_key;;},
   doi                           = {10.1007/S10796-021-10227-4},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/isf/PapagiannidisD22},
   author                        = {Papagiannidis, Savvas and Davlembayeva, Dinara},
   journal                       = {Information Systems Frontiers},
   title                         = {Bringing Smart Home Technology to Peer-to-Peer Accommodation: Exploring the Drivers of Intention to Stay in Smart Accommodation},
   year                          = {2022},
   volume                        = {24},
   number                        = {4},
   pages                         = {1189--1208},
   url                           = {https://link.springer.com/article/10.1007/s10796-021-10227-4},
   abstract                      = {Abstract COVID-19 has caused disruptions in the sharing economy for both platforms and owners, who are typically micro-businesses. Lower demand and ample supply means that users have a great deal of choice. Finding ways for properties to differentiate themselves has been a pressing need. Against this background, this paper pursued two objectives: firstly to explore the perceived functional and emotional value of smart accommodation and the factors contributing to this by adopting the Theory of Consumption Values, and secondly to examine the role of perceived value in driving intention to stay in smart accommodation in the future. 430 responses were collected to analyse the relationships among antecedents, value and intention. The results showed that the functional value of smart accommodation is associated with the perception that such accommodation represents good value for the price, smart devices are useful, they can enhance control of stay experiences, and there are resources and opportunities facilitating the use of technology. Emotional value is determined by the perception that staying in smart accommodation represents sustainable behaviour, the integration of smart home technologies offers control over the stay experience, improves the entertainment experience, aesthetics and playfulness of using technology. Emotional values are inhibited by the perception of surveillance in smart accommodation. Also, the study offers evidence of the correlation of intention with functional and emotional value. The evidence contributes to the literature by explaining the potential implications of innovative technologies for business recovery in the post-pandemic reality, exploring the applications of smart technologies in delivering tourism services, and identifying the factors in the adoption of smart homes in the hospitality sector. The findings provide practical implications for facilitating the applications of innovative technology and its adoption in home and non-home environments.},
   language                      = {eng},
}

