@article{AndrzejewskiBoinski2022,
   colrev_origin                 = {crossref_jissn_15729419.bib/000171;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000171;;
                                    title:crossref_jissn_15729419.bib/000171;;
                                    year:crossref_jissn_15729419.bib/000171;;
                                    author:crossref_jissn_15729419.bib/000171;;
                                    volume:colrev_curation.curation_restrictions;missing;
                                    number:colrev_curation.curation_restrictions;missing;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000171;;
                                    abstract:crossref_jissn_15729419.bib/000171;;
                                    language:crossref_jissn_15729419.bib/000171;;
                                    url:crossref_jissn_15729419.bib/000171;;},
   doi                           = {10.1007/S10796-022-10344-8},
   author                        = {Andrzejewski, Witold and Boinski, Pawel},
   journal                       = {Information Systems Frontiers},
   title                         = {Maximal Mixed-Drove Co-occurrence Patterns},
   year                          = {2022},
   volume                        = {UNKNOWN},
   number                        = {UNKNOWN},
   url                           = {https://link.springer.com/article/10.1007/s10796-022-10344-8},
   abstract                      = {Abstract One of the interesting types of spatio-temporal patterns is the Mixed-Drove Co-occurrence Pattern (MDCOP), which represents types of objects frequently located together in both space and time. To discover such patterns, methods based on the well-known Apriori strategy are widely used. They involve determining multi-element MDCOPs by building them up iteratively starting with the two-element patterns and then successively adding another element in each iteration. This approach can be very costly, particularly when the data is dense enough to form patterns of significant size. In this paper, we introduce a definition of a new pattern type called a Maximal Mixed-Drove Co-occurrence Pattern. We also propose a new algorithm MAXMDCOP-Miner, which resigns from popular Apriori strategy of generating candidates and, therefore, can discover long pattern without processing all their subsets. Experiments performed on synthetic and real datasets show that MAXMDCOP-Miner has high performance, in particular for dense datasets or tasks with low user-defined thresholds of spatial or time prevalence.},
   language                      = {eng},
}

