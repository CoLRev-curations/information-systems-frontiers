@article{Kloker2020,
   colrev_origin                 = {DBLP.bib/001114;
                                    crossref_jissn_15729419.bib/000502;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000502;;
                                    title:crossref_jissn_15729419.bib/000502;;
                                    year:crossref_jissn_15729419.bib/000502;;
                                    volume:crossref_jissn_15729419.bib/000502;;
                                    number:crossref_jissn_15729419.bib/000502;;
                                    pages:crossref_jissn_15729419.bib/000502;;
                                    author:crossref_jissn_15729419.bib/000502;;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000502;;
                                    abstract:crossref_jissn_15729419.bib/000502;;
                                    language:crossref_jissn_15729419.bib/000502;;
                                    url:crossref_jissn_15729419.bib/000502;;
                                    colrev.dblp.dblp_key:DBLP.bib/001114|rename-from:dblp_key;;},
   doi                           = {10.1007/S10796-020-10011-W},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/isf/Kloker20},
   author                        = {Kloker, Simon},
   journal                       = {Information Systems Frontiers},
   title                         = {Non-addictive Information Systems},
   year                          = {2020},
   volume                        = {22},
   number                        = {3},
   pages                         = {549--562},
   url                           = {https://link.springer.com/article/10.1007/s10796-020-10011-w},
   abstract                      = {Abstract Addiction in the context of information technology gained increased public interest within the last years. Only recently, companies like Apple, Google, and Instagram announced to fight smartphone addiction and integrated matching features in their systems. However, if and how these features really help is still an open question. At present, there is only a very rudimentary understanding of IT-triggered disorders and addictions in information systems. Even in clinical research, there is no consensus on the nature of these addictions yet. Nevertheless, the omnipresence of information technology in our daily lives and its unpredictable effects on our moods require this problem to be addressed in a profound manner. This paper links findings from psychology and neuroscience to the information systems terminology and derives the Four-Component Model for Non-addictive Information Systems (4-NAIS). The 4-NAIS allows locating how information technology interacts with the reinforcement cycle of addictions and provides a deeper understanding of where interventions and design decisions may really help tackle IT-triggered disorders.},
   language                      = {eng},
}

