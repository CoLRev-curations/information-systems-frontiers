@article{MarjanovicPatmoreBalnave2022,
   colrev_origin                 = {crossref_jissn_15729419.bib/000151;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000151;;
                                    title:crossref_jissn_15729419.bib/000151;;
                                    year:crossref_jissn_15729419.bib/000151;;
                                    author:crossref_jissn_15729419.bib/000151;;
                                    volume:colrev_curation.curation_restrictions;missing;
                                    number:colrev_curation.curation_restrictions;missing;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000151;;
                                    abstract:crossref_jissn_15729419.bib/000151;;
                                    language:crossref_jissn_15729419.bib/000151;;
                                    url:crossref_jissn_15729419.bib/000151;;},
   doi                           = {10.1007/S10796-022-10310-4},
   author                        = {Marjanovic, Olivera and Patmore, Greg and Balnave, Nikola},
   journal                       = {Information Systems Frontiers},
   title                         = {Visual Analytics: Transferring, Translating and Transforming Knowledge from Analytics Experts to Non-technical Domain Experts in Multidisciplinary Teams},
   year                          = {2022},
   volume                        = {UNKNOWN},
   number                        = {UNKNOWN},
   url                           = {https://link.springer.com/article/10.1007/s10796-022-10310-4},
   abstract                      = {Abstract Today’s complex problems call for multidisciplinary analytics teams comprising of both analytics and non-technical domain (i.e. subject matter) experts. Recognizing the difference between data visualisaion (DV) (i.e. static visual outputs) and visual analytics (VA) (i.e. a process of interactive visual data exploration, guided by user’s domain and contextual knowledge), this paper focuses on VA for non-technical domain experts. By seeking to understand knowledge sharing from VA experts to non-technical users of VA in a multidisciplinary team, we aim to explore how these domain experts learn to use VA as a thinking tool, guided by their knowing-in-practice. The research described in this paper was conducted in the context of a long-term industry-wide research project called the ‘Visual Historical Atlas of the Australian Co-operatives’, led by a multidisciplinary VA team who faced the challenge tackled by this research. Using Action Design Research (ADR) and the combined theoretical lens of boundary objects and secondary design, the paper theorises a three-phase method for knowledge transfer, translation and transformation from VA experts to domain experts using different types of VA-related boundary objects. Together with the proposed set of design principles, the three-phase model advances the well-established stream of research on organizational use of analytics, extending it to the emerging area of visual analytics for non-technical decision makers.},
   language                      = {eng},
}

