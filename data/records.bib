@article{TamilmaniRanaNunkooEtAl2022,
   colrev_origin                 = {DBLP.bib/001394;
                                    crossref_jissn_15729419.bib/000348;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000348;;
                                    title:crossref_jissn_15729419.bib/000348;;
                                    year:crossref_jissn_15729419.bib/000348;;
                                    volume:crossref_jissn_15729419.bib/000348;;
                                    number:crossref_jissn_15729419.bib/000348;;
                                    pages:crossref_jissn_15729419.bib/000348;;
                                    author:crossref_jissn_15729419.bib/000348;;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000348;;
                                    abstract:crossref_jissn_15729419.bib/000348;;
                                    language:crossref_jissn_15729419.bib/000348;;
                                    url:crossref_jissn_15729419.bib/000348;;
                                    colrev.dblp.dblp_key:DBLP.bib/001394|rename-from:dblp_key;;},
   doi                           = {10.1007/S10796-020-10060-1},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/isf/TamilmaniRNRD22},
   author                        = {Tamilmani, Kuttimani and Rana, Nripendra P. and Nunkoo, Robin and Raghavan, Vishnupriya and Dwivedi, Yogesh K.},
   journal                       = {Information Systems Frontiers},
   title                         = {Indian Travellers’ Adoption of Airbnb Platform},
   year                          = {2022},
   volume                        = {24},
   number                        = {1},
   pages                         = {77--96},
   url                           = {https://link.springer.com/article/10.1007/s10796-020-10060-1},
   abstract                      = {Abstract Much of the existing scholarly debate on sharing economy to date has focused on the use of technology in developed countries. However, the recent upsurge of mobile technology adoption in developing countries has provided suitable breeding ground for sharing economy. The lack of native theories in tourism and hospitality sector with scare utilization of unified theory of acceptance and use of technology (UTAUT) provide necessity for this research. This study adapted meta-UTAUT model as theoretical lens and extended the model with hedonic motivation, trust, and self-efficacy. Based on data from 301 potential Indian consumers, the results underscored the central role of attitude that significantly mediated the effects of effort expectancy, social influence, and facilitating conditions on consumer intention to use Airbnb. Meanwhile, performance expectancy emerged as significant direct determinant of intention alongside attitude, trust, and self-efficacy. The proposed model explained as much as 65% variance on Indian consumer’s intention to use Airbnb.},
   language                      = {eng},
}

