@article{Wijnhoven2022,
   colrev_origin                 = {DBLP.bib/001320;
                                    crossref_jissn_15729419.bib/000217;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000217;;
                                    title:crossref_jissn_15729419.bib/000217;;
                                    year:crossref_jissn_15729419.bib/000217;;
                                    volume:crossref_jissn_15729419.bib/000217;;
                                    number:crossref_jissn_15729419.bib/000217;;
                                    pages:crossref_jissn_15729419.bib/000217;;
                                    author:crossref_jissn_15729419.bib/000217;;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000217;;
                                    abstract:crossref_jissn_15729419.bib/000217;;
                                    language:crossref_jissn_15729419.bib/000217;;
                                    url:crossref_jissn_15729419.bib/000217;;
                                    colrev.dblp.dblp_key:DBLP.bib/001320|rename-from:dblp_key;;},
   doi                           = {10.1007/S10796-021-10206-9},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/isf/Wijnhoven22},
   author                        = {Wijnhoven, Fons},
   journal                       = {Information Systems Frontiers},
   title                         = {Organizational Learning for Intelligence Amplification Adoption: Lessons from a Clinical Decision Support System Adoption Project},
   year                          = {2022},
   volume                        = {24},
   number                        = {3},
   pages                         = {731--744},
   url                           = {https://link.springer.com/article/10.1007/s10796-021-10206-9},
   abstract                      = {Abstract Intelligence amplification exploits the opportunities of artificial intelligence, which includes data analytic techniques and codified knowledge for increasing the intelligence of human decision makers. Intelligence amplification does not replace human decision makers but may help especially professionals in making complex decisions by well-designed human-AI system learning interactions (i.e., triple loop learning). To understand the adoption challenges of intelligence amplification systems, we analyse the adoption of clinical decision support systems (CDSS) as an organizational learning process by the case of a CDSS implementation for deciding on administering antibiotics to prematurely born babies. We identify user-oriented single and double loop learning processes, triple loop learning, and institutional deutero learning processes as organizational learning processes that must be realized for effective intelligence amplification adoption. We summarize these insights in a system dynamic model—containing knowledge stocks and their transformation processes—by which we analytically structure insights from the diverse studies of CDSS and intelligence amplification adoption and by which intelligence amplification projects are given an analytic theory for their design and management. From our case study, we find multiple challenges of deutero learning that influence the effectiveness of IA implementation learning as transforming tacit knowledge into explicit knowledge and explicit knowledge back to tacit knowledge. In a discussion of implications, we generate further research directions and discuss the generalization of our case findings to different organizations.},
   language                      = {eng},
}

