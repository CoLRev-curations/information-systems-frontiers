                                    colrev.dblp.dblp_key:DBLP.bib/001350|rename-from:dblp_key;;},
   doi                           = {10.1007/S10796-021-10147-3},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/isf/FranciaMPR22},
   author                        = {Francia, Matteo and Marcel, Patrick and Peralta, Verónika and Rizzi, Stefano},
   journal                       = {Information Systems Frontiers},
   title                         = {Enhancing Cubes with Models to Describe Multidimensional Data},
   year                          = {2022},
   volume                        = {24},
   number                        = {1},
   pages                         = {31--48},
   url                           = {https://link.springer.com/article/10.1007/s10796-021-10147-3},
   abstract                      = {Abstract The Intentional Analytics Model (IAM) has been recently envisioned as a new paradigm to couple OLAP and analytics. It relies on two basic ideas: (i) letting the user explore data by expressing her analysis intentions rather than the data she needs, and (ii) returning enhanced cubes, i.e., multidimensional data annotated with knowledge insights in the form of interesting model components (e.g., clusters). In this paper we contribute to give a proof-of-concept for the IAM vision by delivering an end-to-end implementation of , one of the five intention operators introduced by IAM. Among the research challenges left open in IAM, those we address are (i) automatically tuning the size of models (e.g., the number of clusters), (ii) devising a measure to estimate the interestingness of model components, (iii) selecting the most effective chart or graph for visualizing each enhanced cube depending on its features, and (iv) devising a visual metaphor to display enhanced cubes and interact with them. We assess the validity of our approach in terms of user effort for formulating intentions, effectiveness, efficiency, and scalability.},
   language                      = {eng},
}

