@article{SpagnolettiCeciBygstad2022,
   colrev_origin                 = {DBLP.bib/001317;
                                    crossref_jissn_15729419.bib/000101;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000101;;
