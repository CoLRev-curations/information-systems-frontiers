@article{PapagiannidisEnholmDremelEtAl2023,
   colrev_origin                 = {DBLP.bib/001431;
                                    crossref_jissn_15729419.bib/000042;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000042;;
                                    title:crossref_jissn_15729419.bib/000042;;
                                    year:crossref_jissn_15729419.bib/000042;;
