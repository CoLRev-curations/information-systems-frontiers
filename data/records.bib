@article{KhnaisserHamrouniBlumenthalEtAl2024,
   colrev_origin                 = {crossref_jissn_15729419.bib/001850;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {author:crossref_jissn_15729419.bib/001850;;
                                    journal:crossref_jissn_15729419.bib/001850;;
