@article{FrommEyilmezBafeldEtAl2023,
   colrev_origin                 = {DBLP.bib/001416;
                                    crossref_jissn_15729419.bib/000032;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000032;;
                                    title:crossref_jissn_15729419.bib/000032;;
                                    year:crossref_jissn_15729419.bib/000032;;
                                    volume:crossref_jissn_15729419.bib/000032;;
                                    number:crossref_jissn_15729419.bib/000032;;
                                    pages:crossref_jissn_15729419.bib/000032;;
                                    author:crossref_jissn_15729419.bib/000032;;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000032;;
                                    abstract:crossref_jissn_15729419.bib/000032;;
                                    language:crossref_jissn_15729419.bib/000032;;
                                    url:crossref_jissn_15729419.bib/000032;;
                                    colrev.dblp.dblp_key:DBLP.bib/001416|rename-from:dblp_key;;},
   doi                           = {10.1007/S10796-020-10101-9},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/isf/FrommEBMS23},
   author                        = {Fromm, Jennifer and Eyilmez, Kaan and Baßfeld, Melina and Majchrzak, Tim A. and Stieglitz, Stefan},
   journal                       = {Information Systems Frontiers},
   title                         = {Social Media Data in an Augmented Reality System for Situation Awareness Support in Emergency Control Rooms},
   year                          = {2023},
   volume                        = {25},
   number                        = {1},
   pages                         = {303--326},
   url                           = {https://link.springer.com/article/10.1007/s10796-020-10101-9},
   abstract                      = {Abstract During crisis situations, emergency operators require fast information access to achieve situation awareness and make the best possible decisions. Augmented reality could be used to visualize the wealth of user-generated content available on social media and enable context-adaptive functions for emergency operators. Although emergency operators agree that social media analytics will be important for their future work, it poses a challenge to filter and visualize large amounts of social media data. We conducted a goal-directed task analysis to identify the situation awareness requirements of emergency operators. By collecting tweets during two storms in Germany we evaluated the usefulness of Twitter data for achieving situation awareness and conducted interviews with emergency operators to derive filter strategies for social media data. We synthesized the results by discussing how the unique interface of augmented reality can be used to integrate social media data into emergency control rooms for situation awareness support.},
   language                      = {eng},
}

