@article{FujitaHatayama2023,
   colrev_origin                 = {DBLP.bib/001422;
                                    crossref_jissn_15729419.bib/000046;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000046;;
