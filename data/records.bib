@article{MeskeBunde2022,
   colrev_origin                 = {crossref_jissn_15729419.bib/000357;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000357;;
