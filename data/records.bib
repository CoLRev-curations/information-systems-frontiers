@article{SinghKumarRanaEtAl2022,
   colrev_origin                 = {DBLP.bib/001389;
                                    crossref_jissn_15729419.bib/000276;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000276;;
                                    title:crossref_jissn_15729419.bib/000276;;
                                    year:crossref_jissn_15729419.bib/000276;;
                                    volume:crossref_jissn_15729419.bib/000276;;
                                    number:crossref_jissn_15729419.bib/000276;;
                                    pages:crossref_jissn_15729419.bib/000276;;
                                    author:crossref_jissn_15729419.bib/000276;;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000276;;
                                    abstract:crossref_jissn_15729419.bib/000276;;
                                    language:crossref_jissn_15729419.bib/000276;;
                                    url:crossref_jissn_15729419.bib/000276;;
                                    colrev.dblp.dblp_key:DBLP.bib/001389|rename-from:dblp_key;;},
   doi                           = {10.1007/S10796-020-10040-5},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/isf/SinghKRD22},
   author                        = {Singh, Jyoti Prakash and Kumar, Abhinav and Rana, Nripendra P. and Dwivedi, Yogesh K.},
   journal                       = {Information Systems Frontiers},
   title                         = {Attention-Based LSTM Network for Rumor Veracity Estimation of Tweets},
   year                          = {2022},
   volume                        = {24},
   number                        = {2},
   pages                         = {459--474},
   url                           = {https://link.springer.com/article/10.1007/s10796-020-10040-5},
   abstract                      = {Abstract Twitter has become a fertile place for rumors, as information can spread to a large number of people immediately. Rumors can mislead public opinion, weaken social order, decrease the legitimacy of government, and lead to a significant threat to social stability. Therefore, timely detection and debunking rumor are urgently needed. In this work, we proposed an Attention-based Long-Short Term Memory (LSTM) network that uses tweet text with thirteen different linguistic and user features to distinguish rumor and non-rumor tweets. The performance of the proposed Attention-based LSTM model is compared with several conventional machine and deep learning models. The proposed Attention-based LSTM model achieved an F 1 -score of 0.88 in classifying rumor and non-rumor tweets, which is better than the state-of-the-art results. The proposed system can reduce the impact of rumors on society and weaken the loss of life, money, and build the firm trust of users with social media platforms.},
   language                      = {eng},
}

