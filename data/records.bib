   colrev_data_provenance        = {abstract:crossref_jissn_15729419.bib/001724;;
                                    doi:crossref_jissn_15729419.bib/001724;;
                                    language:crossref_jissn_15729419.bib/001724;;
                                    url:crossref_jissn_15729419.bib/001724;;},
   doi                           = {10.1007/S10796-023-10428-Z},
   author                        = {Tang, Zhewen and Shah, Mahmood and Jamal, Arshad},
   journal                       = {Information Systems Frontiers},
   title                         = {Exploring the Process of Technology Socialization (TS) in the Family: ICT Adoption for Middle-aged Parents with the Influence of Adult Children},
   year                          = {2024},
   volume                        = {26},
   number                        = {5},
   pages                         = {1873--1892},
   url                           = {https://link.springer.com/article/10.1007/s10796-023-10428-z},
   abstract                      = {Family is an important socialization environment for adopting information and communication technologies (ICTs). However, while existing information systems research focuses on individual factors that influence digital inequity, it tends to ignore the influence of relational/collective factors on individuals’ ICT adoption. Drawing on technology adoption, socialization, and social identity theories, this study focuses on the process of technology socialization of ICT adoption for middle-aged parents with the influence of their adult children in Chinese families. Through in-depth interviews with thematic analysis, we identify three mechanisms in the family, including creating a family shared environment, negotiating a family ICT identity and interplay, and generating digital differentiation. These findings contribute to a technology socialization framework, addressing how individuals can become digitally savvy with the influence of the socialization agents in the family. The findings have implications for ICT firms and policy makers to promote the family shared environment as a vehicle for achieving social wellbeing and digital upskilling of middle-aged adults.},
   language                      = {eng},
}

