@article{AlshareMoqbelMerhiEtAl2025a,
   colrev_origin                 = {crossref_jissn_15729419.bib/001626;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {author:crossref_jissn_15729419.bib/001626;;
                                    journal:crossref_jissn_15729419.bib/001626;;
                                    number:crossref_jissn_15729419.bib/001626;;
                                    pages:crossref_jissn_15729419.bib/001626;;
                                    title:crossref_jissn_15729419.bib/001626;;
                                    volume:crossref_jissn_15729419.bib/001626;;
                                    year:crossref_jissn_15729419.bib/001626;;},
   colrev_data_provenance        = {abstract:crossref_jissn_15729419.bib/001626;;
                                    doi:crossref_jissn_15729419.bib/001626;;
                                    language:crossref_jissn_15729419.bib/001626;;
                                    url:crossref_jissn_15729419.bib/001626;;},
   doi                           = {10.1007/S10796-024-10544-4},
   author                        = {Alshare, Khaled and Moqbel, Murad and Merhi, Mohammad I. and Bartelt, Valerie and Alam, Maliha},
   journal                       = {Information Systems Frontiers},
   title                         = {The Impact of Cultural Dimensions and Quality of Life on Smartphone Addiction and Employee Performance: The Moderating Role of Quality of Life},
   year                          = {2025},
   volume                        = {27},
   number                        = {4},
   pages                         = {1651--1669},
   url                           = {https://link.springer.com/article/10.1007/s10796-024-10544-4},
   abstract                      = {Smartphones, while ubiquitous and beneficial, can lead to problematic use. This study investigates the intricate interplay between cultural dimensions, smartphone addiction, and employee performance. Through the lens of distraction theory, attachment Theory, coping theory combined with Hofstede's cultural dimensions, and self-regulation theory and quality of life, we examine how collectivism, individualism, uncertainty avoidance, and masculinity cultural dimensions influence smartphone addiction and its subsequent effect on employee performance. The findings, based on data collected from 233 employees at a major medical center in the Midwest region of the USA and employing structural equation modeling, reveal a significant cultural influence on smartphone addiction, ultimately leading to a decline in performance. However, quality of life emerges as a crucial moderator, mitigating the negative impact of smartphone addiction. This research offers valuable insights for information systems scholars, highlighting the importance of cultural context in understanding smartphone addiction. Furthermore, the study equips managers with practical knowledge to address smartphone addiction within a culturally diverse workforce. By implementing strategies that enhance employee quality of life, organizations can foster a more productive and engaged work environment.},
   language                      = {eng},
}

