@article{ShahiBasyurtStieglitzEtAl2025,
   colrev_origin                 = {crossref_jissn_15729419.bib/001687;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {author:crossref_jissn_15729419.bib/001687;;
                                    journal:crossref_jissn_15729419.bib/001687;;
                                    number:crossref_jissn_15729419.bib/001687;;
                                    pages:crossref_jissn_15729419.bib/001687;;
                                    title:crossref_jissn_15729419.bib/001687;;
                                    volume:crossref_jissn_15729419.bib/001687;;
                                    year:crossref_jissn_15729419.bib/001687;;},
   colrev_data_provenance        = {abstract:crossref_jissn_15729419.bib/001687;;
                                    doi:crossref_jissn_15729419.bib/001687;;
                                    language:crossref_jissn_15729419.bib/001687;;
                                    url:crossref_jissn_15729419.bib/001687;;},
   doi                           = {10.1007/S10796-024-10568-W},
   author                        = {Shahi, Gautam Kishore and Basyurt, Ali Sercan and Stieglitz, Stefan and Neuberger, Christoph},
   journal                       = {Information Systems Frontiers},
   title                         = {Agenda Formation and Prediction of Voting Tendencies for European Parliament Election using Textual, Social and Network Features},
   year                          = {2025},
   volume                        = {27},
   number                        = {4},
   pages                         = {1425--1443},
   url                           = {https://link.springer.com/article/10.1007/s10796-024-10568-w},
   abstract                      = {As per agenda-setting theory, political agenda is concerned with the government’s agenda, including politicians and political parties. Political actors utilize various channels to set their political agenda, including social media platforms such as Twitter (now X ). Political agenda-setting can be influenced by anonymous user-generated content following the Bright Internet. This is why speech acts, experts, users with affiliations and parties through annotated Tweets were analyzed in this study. In doing so, the agenda formation during the 2019 European Parliament Election in Germany based on the agenda-setting theory as our theoretical framework, was analyzed. A prediction model was trained to predict users’ voting tendencies based on three feature categories: social, network, and text. By combining features from all categories logistical regression leads to the best predictions matching the election results. The contribution to theory is an approach to identify agenda formation based on our novel variables. For practice, a novel approach is presented to forecast the winner of events.},
   language                      = {eng},
}

