   volume                        = {UNKNOWN},
   number                        = {UNKNOWN},
   url                           = {https://link.springer.com/article/10.1007/s10796-022-10286-1},
   abstract                      = {Abstract Virtual Reality (VR) is becoming an increasingly important technology in a host of industries, including tourism. VR can provide virtual experiences before, during, or in lieu of real-world visits to tourism sites. Hence, providing authentic experiences is essential to satisfy guests with the site and technology. This study analyzes survey data using PLS to identify the determinants of satisfaction with non-immersive VR experiences of heritage and non-heritage tourism sites. Results from 193 subjects reveal the linkages between system quality, object-related authenticity, activity-related authenticity, and presence, as well their relationship with satisfaction.},
   language                      = {eng},
}

