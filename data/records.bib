@article{GuptaHoodaJeyarajEtAl2025,
   colrev_origin                 = {crossref_jissn_15729419.bib/001846;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {author:crossref_jissn_15729419.bib/001846;;
