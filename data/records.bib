@article{MarjanovicKovacevicOpacic2025,
   colrev_origin                 = {crossref_jissn_15729419.bib/001581;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {author:crossref_jissn_15729419.bib/001581;;
                                    journal:crossref_jissn_15729419.bib/001581;;
