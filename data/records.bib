@article{IannacciFearonPole2021,
   colrev_origin                 = {DBLP.bib/001257;
                                    crossref_jissn_15729419.bib/000174;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000174;;
                                    title:crossref_jissn_15729419.bib/000174;;
                                    year:crossref_jissn_15729419.bib/000174;;
                                    volume:crossref_jissn_15729419.bib/000174;;
                                    number:crossref_jissn_15729419.bib/000174;;
                                    pages:crossref_jissn_15729419.bib/000174;;
                                    author:crossref_jissn_15729419.bib/000174;;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000174;;
                                    abstract:crossref_jissn_15729419.bib/000174;;
                                    language:crossref_jissn_15729419.bib/000174;;
                                    url:crossref_jissn_15729419.bib/000174;;
                                    colrev.dblp.dblp_key:DBLP.bib/001257|rename-from:dblp_key;;},
   doi                           = {10.1007/S10796-020-09988-1},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/isf/IannacciFP21},
   author                        = {Iannacci, Federico and Fearon, Colm and Pole, Kristine},
   journal                       = {Information Systems Frontiers},
   title                         = {From Acceptance to Adaptive Acceptance of Social Media Policy Change: a Set-Theoretic Analysis of B2B SMEs},
   year                          = {2021},
   volume                        = {23},
   number                        = {3},
   pages                         = {663--680},
   url                           = {https://link.springer.com/article/10.1007/s10796-020-09988-1},
   abstract                      = {Abstract Drawing on theories of mindfulness, this paper aims to introduce the concept of adaptive acceptance of social media policy change in the context of Business-to-Business (B2B) Small-and-Medium Enterprises (SMEs) based in the South East of England. The paper adopts a quasi-experimental design based on the analysis of multiple cases with each case replicating prior findings either literally or theoretically. The study uses a mix of survey, interview, and electronic data informed by an innovative, set-theoretic approach to distill commonalities within positive cases and differences between positive and negative cases. It shows that attracting new customers and raising the company’s profile are necessary pre-requisites for adaptive acceptance of social media policy changes. In addition, these two conditions combined with learning to use social media effortlessly are jointly sufficient for adaptive acceptance. Theoretical, practical, and methodological implications are discussed.},
   language                      = {eng},
}

