@article{MunteanuMurariuNichiteanEtAl2025a,
   colrev_origin                 = {crossref_jissn_15729419.bib/001606;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {author:crossref_jissn_15729419.bib/001606;;
                                    journal:crossref_jissn_15729419.bib/001606;;
                                    number:crossref_jissn_15729419.bib/001606;;
