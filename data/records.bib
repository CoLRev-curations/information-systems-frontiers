@article{Karimi2021,
   colrev_origin                 = {DBLP.bib/001262;
                                    crossref_jissn_15729419.bib/000478;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000478;;
                                    title:crossref_jissn_15729419.bib/000478;;
                                    year:crossref_jissn_15729419.bib/000478;;
                                    volume:crossref_jissn_15729419.bib/000478;;
                                    number:crossref_jissn_15729419.bib/000478;;
                                    pages:crossref_jissn_15729419.bib/000478;;
