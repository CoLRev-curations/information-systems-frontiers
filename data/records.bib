@article{TamilmaniRanaDwivedi2021,
   colrev_origin                 = {DBLP.bib/001224;
                                    crossref_jissn_15729419.bib/000446;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000446;;
                                    title:crossref_jissn_15729419.bib/000446;;
                                    year:crossref_jissn_15729419.bib/000446;;
                                    volume:crossref_jissn_15729419.bib/000446;;
                                    number:crossref_jissn_15729419.bib/000446;;
                                    pages:crossref_jissn_15729419.bib/000446;;
                                    author:crossref_jissn_15729419.bib/000446;;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000446;;
                                    abstract:crossref_jissn_15729419.bib/000446;;
                                    language:crossref_jissn_15729419.bib/000446;;
                                    url:crossref_jissn_15729419.bib/000446;;
                                    colrev.dblp.dblp_key:DBLP.bib/001224|rename-from:dblp_key;;},
   doi                           = {10.1007/S10796-020-10007-6},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/isf/TamilmaniRD21},
   author                        = {Tamilmani, Kuttimani and Rana, Nripendra P. and Dwivedi, Yogesh K.},
   journal                       = {Information Systems Frontiers},
   title                         = {Consumer Acceptance and Use of Information Technology: A Meta-Analytic Evaluation of UTAUT2},
   year                          = {2021},
   volume                        = {23},
   number                        = {4},
   pages                         = {987--1005},
   url                           = {https://link.springer.com/article/10.1007/s10796-020-10007-6},
   abstract                      = {Abstract Despite being regarded as the most comprehensive theory in understanding individual technology adoption – UTAUT2 theory with growing number of citations and impetus beyond IS domain face strong criticism on usage of the model in its entirety. This study located UTAUT2 based empirical studies in the Scopus and Web of Science bibliographic database through citied reference search in order to evaluate appropriate usage of UTAUT2 constructs. The meta-analysis results spanning across 60 studies with more than 122,000 cumulative observations found BI➔UB as the strongest path with all significant values. PE➔BI emerged as the most utilized path with most significant values underscoring the emphasis placed by consumers on utilitarian value. Meanwhile, with most non-significant path values the future usage of EE➔BI path is been cautioned and questioned. Finally, trust, personal innovativeness, perceived risk, attitude, and self-efficacy were found as the five topmost UTAUT2 extensions.},
   language                      = {eng},
}

