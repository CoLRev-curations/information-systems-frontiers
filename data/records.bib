@article{SchmidHartwigCieslinskiEtAl2022,
   colrev_origin                 = {crossref_jissn_15729419.bib/000001;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000001;;
                                    title:crossref_jissn_15729419.bib/000001;;
                                    year:crossref_jissn_15729419.bib/000001;;
                                    author:crossref_jissn_15729419.bib/000001;;
                                    volume:colrev_curation.curation_restrictions;missing;
                                    number:colrev_curation.curation_restrictions;missing;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000001;;
                                    abstract:crossref_jissn_15729419.bib/000001;;
                                    language:crossref_jissn_15729419.bib/000001;;
                                    url:crossref_jissn_15729419.bib/000001;;},
   doi                           = {10.1007/S10796-022-10347-5},
   author                        = {Schmid, Stefka and Hartwig, Katrin and Cieslinski, Robert and Reuter, Christian},
   journal                       = {Information Systems Frontiers},
   title                         = {Digital Resilience in Dealing with Misinformation on Social Media during COVID-19},
   year                          = {2022},
   volume                        = {UNKNOWN},
   number                        = {UNKNOWN},
   url                           = {https://link.springer.com/article/10.1007/s10796-022-10347-5},
   abstract                      = {Abstract In crises such as the COVID-19 pandemic, it is crucial to support users when dealing with social media content. Considering digital resilience, we propose a web app based on Social Network Analysis (SNA) to provide an overview of potentially misleading vs. non-misleading content on Twitter, which can be explored by users and enable foundational learning. The latter aims at systematically identifying thematic patterns which may be associated with misleading information. Additionally, it entails reflecting on indicators of misleading tweets which are proposed to approach classification of tweets. Paying special attention to non-expert users of social media, we conducted a two-step Think Aloud study for evaluation. While participants valued the opportunity to generate new knowledge and the diversity of the application, qualities such as equality and rapidity may be further improved. However, learning effects outweighed individual costs as all users were able to shift focus onto relevant features, such as hashtags, while readily pointing out content characteristics. Our design artifact connects to learning-oriented interventions regarding the spread of misleading information and tackles information overload by a SNA-based plug-in.},
   language                      = {eng},
