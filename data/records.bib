@article{AhmadSiemonGnewuchEtAl2022,
   colrev_origin                 = {DBLP.bib/001324;
                                    crossref_jissn_15729419.bib/000059;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000059;;
                                    title:crossref_jissn_15729419.bib/000059;;
                                    year:crossref_jissn_15729419.bib/000059;;
                                    volume:crossref_jissn_15729419.bib/000059;;
                                    number:crossref_jissn_15729419.bib/000059;;
                                    pages:crossref_jissn_15729419.bib/000059;;
                                    author:crossref_jissn_15729419.bib/000059;;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000059;;
