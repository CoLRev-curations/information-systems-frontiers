@article{GuptaModgilBhushanEtAl2025,
   colrev_origin                 = {crossref_jissn_15729419.bib/001459;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {author:crossref_jissn_15729419.bib/001459;;
                                    journal:crossref_jissn_15729419.bib/001459;;
                                    number:crossref_jissn_15729419.bib/001459;;
                                    pages:crossref_jissn_15729419.bib/001459;;
                                    title:crossref_jissn_15729419.bib/001459;;
                                    volume:crossref_jissn_15729419.bib/001459;;
                                    year:crossref_jissn_15729419.bib/001459;;},
   colrev_data_provenance        = {abstract:crossref_jissn_15729419.bib/001459;;
                                    doi:crossref_jissn_15729419.bib/001459;;
                                    language:crossref_jissn_15729419.bib/001459;;
                                    url:crossref_jissn_15729419.bib/001459;;},
   doi                           = {10.1007/S10796-023-10451-0},
   author                        = {Gupta, Shivam and Modgil, Sachin and Bhushan, Bharat and Sivarajah, Uthayasankar and Banerjee, Santanu},
   journal                       = {Information Systems Frontiers},
   title                         = {Design and Implementation of an IIoT Driven Information System: A Case Study},
   year                          = {2025},
   volume                        = {27},
   number                        = {2},
   pages                         = {523--537},
   url                           = {https://link.springer.com/article/10.1007/s10796-023-10451-0},
   abstract                      = {Information systems are critical for companies since they offer quick and easy access to complex and significant data in a structured manner to make informed and effective business decisions. Hence, the objective of this study is to conceptualize and implement an innovative information system in the case study organization. The study identified the requirements for Organizing Vision Theory (OVT) and developed architecture based on Organizational Information Processing Theory (OIPT). This architecture is designed and developed using the Industrial Internet of Things (IIoT) to support a self-organizing vision and enhanced information processing. The study’s contribution lies in developing and executing an integrative architecture of IIoT-driven information systems from the lenses of OVT and OIPT. Further, this study contributes by mapping OVT elements (such as transparency, continuity, and coherence) and OIPT elements (information processing needs and capabilities) to drive value and knowledge through a robust architecture of IIoT-driven information systems. The study also highlights the contribution of IIoT-based information systems to a new knowledge system, facilitating better decision-making by professionals.},
   language                      = {eng},
}

