@article{ZamaniPouloudiGiaglisEtAl2019,
   colrev_origin                 = {DBLP.bib/001299;
                                    crossref_jissn_15729419.bib/000537;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000537;;
                                    title:crossref_jissn_15729419.bib/000537;;
                                    year:crossref_jissn_15729419.bib/000537;;
                                    author:crossref_jissn_15729419.bib/000537;;
                                    volume:DBLP.bib/001299;;
                                    number:DBLP.bib/001299;;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000537;;
                                    abstract:crossref_jissn_15729419.bib/000537;;
                                    language:crossref_jissn_15729419.bib/000537;;
                                    url:crossref_jissn_15729419.bib/000537;;
                                    colrev.dblp.dblp_key:DBLP.bib/001299|rename-from:dblp_key;;},
   doi                           = {10.1007/S10796-019-09972-4},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/isf/ZamaniPGW21},
   author                        = {Zamani, Efpraxia D. and Pouloudi, Nancy and Giaglis, George and Wareham, Jonathan},
   journal                       = {Information Systems Frontiers},
   title                         = {Accommodating Practices During Episodes of Disillusionment with Mobile IT},
   year                          = {2019},
   volume                        = {23},
   number                        = {2},
   url                           = {https://link.springer.com/article/10.1007/s10796-019-09972-4},
   abstract                      = {Abstract This study investigates how tablet users react when technology falls short of their expectations. We deploy a data/frame model to study this process and investigate resistance-related reactions and the deployment of accommodating practices at the individual level. Analyzing user blogs that provide narratives on user interaction with tablets, we identify triggers of episodes of disillusionment and illustrate five sensemaking paths that users follow, eventually leading to one of three practices: 1) users choose to defer tasks until the situation changes, or they abandon the platform altogether; 2) they develop workarounds at different levels of proficiency; or 3) they proceed by reframing their expectations of the platform. By revealing user decision-making process during episodes of disillusionment, the findings contribute to information systems post-adoption research. At a practical level, the findings inform IT artifact and application design by offering insights on how users process discrepancies between their expectations and actual use experience.},
   language                      = {eng},
}

