@article{VossingKuhlLindEtAl2022,
   colrev_origin                 = {DBLP.bib/001398;
                                    crossref_jissn_15729419.bib/000216;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000216;;
                                    title:crossref_jissn_15729419.bib/000216;;
                                    year:crossref_jissn_15729419.bib/000216;;
                                    volume:crossref_jissn_15729419.bib/000216;;
                                    number:crossref_jissn_15729419.bib/000216;;
                                    pages:crossref_jissn_15729419.bib/000216;;
                                    author:crossref_jissn_15729419.bib/000216;;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000216;;
                                    abstract:crossref_jissn_15729419.bib/000216;;
                                    language:crossref_jissn_15729419.bib/000216;;
                                    url:crossref_jissn_15729419.bib/000216;;
                                    colrev.dblp.dblp_key:DBLP.bib/001398|rename-from:dblp_key;;},
   doi                           = {10.1007/S10796-022-10284-3},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/isf/VossingKLS22},
   author                        = {Vössing, Michael and Kühl, Niklas and Lind, Matteo and Satzger, Gerhard},
   journal                       = {Information Systems Frontiers},
   title                         = {Designing Transparency for Effective Human-AI Collaboration},
   year                          = {2022},
   volume                        = {24},
   number                        = {3},
   pages                         = {877--895},
   url                           = {https://link.springer.com/article/10.1007/s10796-022-10284-3},
   abstract                      = {Abstract The field of artificial intelligence (AI) is advancing quickly, and systems can increasingly perform a multitude of tasks that previously required human intelligence. Information systems can facilitate collaboration between humans and AI systems such that their individual capabilities complement each other. However, there is a lack of consolidated design guidelines for information systems facilitating the collaboration between humans and AI systems. This work examines how agent transparency affects trust and task outcomes in the context of human-AI collaboration. Drawing on the 3-Gap framework, we study agent transparency as a means to reduce the information asymmetry between humans and the AI. Following the Design Science Research paradigm, we formulate testable propositions, derive design requirements, and synthesize design principles. We instantiate two design principles as design features of an information system utilized in the hospitality industry. Further, we conduct two case studies to evaluate the effects of agent transparency: We find that trust increases when the AI system provides information on its reasoning, while trust decreases when the AI system provides information on sources of uncertainty. Additionally, we observe that agent transparency improves task outcomes as it enhances the accuracy of judgemental forecast adjustments.},
   language                      = {eng},
}

