@article{WendtAdamBenlianEtAl2022,
   colrev_origin                 = {DBLP.bib/001319;
                                    crossref_jissn_15729419.bib/000071;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000071;;
                                    title:crossref_jissn_15729419.bib/000071;;
                                    year:crossref_jissn_15729419.bib/000071;;
                                    volume:crossref_jissn_15729419.bib/000071;;
                                    number:crossref_jissn_15729419.bib/000071;;
                                    pages:crossref_jissn_15729419.bib/000071;;
                                    author:crossref_jissn_15729419.bib/000071;;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000071;;
                                    abstract:crossref_jissn_15729419.bib/000071;;
                                    language:crossref_jissn_15729419.bib/000071;;
                                    url:crossref_jissn_15729419.bib/000071;;
                                    colrev.dblp.dblp_key:DBLP.bib/001319|rename-from:dblp_key;;},
   doi                           = {10.1007/S10796-021-10210-Z},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/isf/WendtABK22},
   author                        = {Wendt, Charlotte and Adam, Martin and Benlian, Alexander and Kraus, Sascha},
   journal                       = {Information Systems Frontiers},
   title                         = {Let’s Connect to Keep the Distance: How SMEs Leverage Information and Communication Technologies to Address the COVID-19 Crisis},
   year                          = {2022},
   volume                        = {24},
   number                        = {4},
   pages                         = {1061--1079},
   url                           = {https://link.springer.com/article/10.1007/s10796-021-10210-z},
   abstract                      = {Abstract COVID-19 caused significant challenges for small and medium-sized enterprises (SMEs) in the event industry. To address these challenges, many SMEs leveraged information and communication technologies (ICTs), with some even emerging strengthened from the crisis. Drawing on the technology-organization-environment framework and technology-affordances-and-constraints theory, we investigate the adoption of ICTs as a crisis response strategy in 10 SMEs in the German business event (e.g., corporate events, conferences) industry. Our findings reveal that ICT adoption not only depends on rational decisions based on organizational, environmental, and technological characteristics, but also on these dimensions’ interrelationship and the specific ICTs’ affordances and constraints. Introducing readily available ICTs (e.g., video-conferencing) has significant potential in addressing physical distancing in the short and medium term, while more sophisticated ICTs (e.g., virtual reality) are more likely to gain importance in the long term. Thus, we expand our understanding of organizational technology adoption and ICT-enabled crisis response strategies in SMEs.},
   language                      = {eng},
}

