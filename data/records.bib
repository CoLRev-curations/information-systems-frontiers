@article{TrocinMikalefPapamitsiouEtAl2021,
   colrev_origin                 = {crossref_jissn_15729419.bib/000079;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000079;;
