@article{IdowuElbanna2022,
   colrev_origin                 = {DBLP.bib/001357;
                                    crossref_jissn_15729419.bib/000269;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000269;;
                                    title:crossref_jissn_15729419.bib/000269;;
                                    year:crossref_jissn_15729419.bib/000269;;
                                    volume:crossref_jissn_15729419.bib/000269;;
                                    number:crossref_jissn_15729419.bib/000269;;
                                    pages:crossref_jissn_15729419.bib/000269;;
                                    author:crossref_jissn_15729419.bib/000269;;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000269;;
                                    abstract:crossref_jissn_15729419.bib/000269;;
                                    language:crossref_jissn_15729419.bib/000269;;
                                    url:crossref_jissn_15729419.bib/000269;;
                                    colrev.dblp.dblp_key:DBLP.bib/001357|rename-from:dblp_key;;},
   doi                           = {10.1007/S10796-020-10036-1},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/isf/IdowuE22},
   author                        = {Idowu, Ayomikun and Elbanna, Amany},
   journal                       = {Information Systems Frontiers},
   title                         = {Digital Platforms of Work and the Crafting of Career Path: The Crowdworkers’ Perspective},
   year                          = {2022},
   volume                        = {24},
   number                        = {2},
   pages                         = {441--457},
   url                           = {https://link.springer.com/article/10.1007/s10796-020-10036-1},
   abstract                      = {Abstract Work and Employment is a critical area that is undergoing major change influenced by the widespread connectivity and utilisation of the Internet and the rise of digital platforms. Crowdwork is an emerging new way of working that is witnessing exponential growth. It is surrounded by a fixed debate between opposite perspectives on its impact on workers. However, both perspectives adopt a static view that does not pay much attention to crowdworkers’ progress in their job over time. In this study, we seek to advance this debate by adopting a dynamic view of crowdwork to explore the trajectory of workers over time based on their own accounts. Through rich qualitative data and inductive analysis, the study unravels that crowdworkers craft what could be conceptualised as a career development path. It identifies five stages in this career path and workers’ efforts to mould their work demands and job-related resources to create a future for themselves. The discussion shows the fruitful insight that this approach brings to theory and practice. Limitations and future avenues for research are then discussed.},
   language                      = {eng},
}

