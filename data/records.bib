@article{MinkkinenZimmerMantymaki2023,
   colrev_origin                 = {DBLP.bib/001429;
                                    crossref_jissn_15729419.bib/000043;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000043;;
                                    title:crossref_jissn_15729419.bib/000043;;
                                    year:crossref_jissn_15729419.bib/000043;;
                                    volume:crossref_jissn_15729419.bib/000043;;
                                    number:crossref_jissn_15729419.bib/000043;;
                                    pages:crossref_jissn_15729419.bib/000043;;
                                    author:crossref_jissn_15729419.bib/000043;;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000043;;
                                    abstract:crossref_jissn_15729419.bib/000043;;
                                    language:crossref_jissn_15729419.bib/000043;;
                                    url:crossref_jissn_15729419.bib/000043;;
                                    colrev.dblp.dblp_key:DBLP.bib/001429|rename-from:dblp_key;;},
   doi                           = {10.1007/S10796-022-10269-2},
   colrev.dblp.dblp_key          = {https://dblp.org/rec/journals/isf/MinkkinenZM23},
   author                        = {Minkkinen, Matti and Zimmer, Markus Philipp and Mäntymäki, Matti},
   journal                       = {Information Systems Frontiers},
   title                         = {Co-Shaping an Ecosystem for Responsible AI: Five Types of Expectation Work in Response to a Technological Frame},
   year                          = {2023},
   volume                        = {25},
   number                        = {1},
   pages                         = {103--121},
   url                           = {https://link.springer.com/article/10.1007/s10796-022-10269-2},
   abstract                      = {Abstract Governing artificial intelligence (AI) requires cooperation, although the collaboration’s form remains unclear. Technological frames provide a theoretical perspective for understanding how actors interpret a technology and act upon its development, use, and governance. However, we know little about how actors shape technological frames. In this paper, we study the shaping of the technological frame of the European ecosystem for responsible AI (RAI). Through an analysis of EU documents, we identified four expectations that constitute the EU’s technological frame for the RAI ecosystem. Moreover, through interviews with RAI actors, we revealed five types of expectation work responding to this frame: reproducing, translating, and extending (congruent expectation work), and scrutinizing and rooting (incongruent expectation work). Furthermore, we conceptualize expectation work as actors’ purposive actions in creating and negotiating expectations. Our study contributes to the literature on technological frames, technology-centered ecosystems, and RAI while also elucidating the dimensions and co-shaping of technological frames.},
   language                      = {eng},
}

