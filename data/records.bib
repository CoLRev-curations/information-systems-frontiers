@article{MusaAwanZahrah2022,
   colrev_origin                 = {crossref_jissn_15729419.bib/000145;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000145;;
                                    title:crossref_jissn_15729419.bib/000145;;
                                    year:crossref_jissn_15729419.bib/000145;;
                                    author:crossref_jissn_15729419.bib/000145;;
