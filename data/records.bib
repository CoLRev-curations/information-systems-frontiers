@article{ModgilSinghGuptaEtAl2021,
   colrev_origin                 = {crossref_jissn_15729419.bib/000392;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000392;;
                                    title:crossref_jissn_15729419.bib/000392;;
                                    year:crossref_jissn_15729419.bib/000392;;
                                    author:crossref_jissn_15729419.bib/000392;;
                                    volume:colrev_curation.curation_restrictions;missing;
                                    number:colrev_curation.curation_restrictions;missing;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/000392;;
                                    abstract:crossref_jissn_15729419.bib/000392;;
                                    language:crossref_jissn_15729419.bib/000392;;
                                    url:crossref_jissn_15729419.bib/000392;;},
   doi                           = {10.1007/S10796-021-10222-9},
   author                        = {Modgil, Sachin and Singh, Rohit Kumar and Gupta, Shivam and Dennehy, Denis},
   journal                       = {Information Systems Frontiers},
   title                         = {A Confirmation Bias View on Social Media Induced Polarisation During Covid-19},
   year                          = {2021},
   volume                        = {UNKNOWN},
   number                        = {UNKNOWN},
   url                           = {https://link.springer.com/article/10.1007/s10796-021-10222-9},
   abstract                      = {Abstract Social media has played a pivotal role in polarising views on politics, climate change, and more recently, the Covid-19 pandemic. Social media induced polarisation (SMIP) poses serious challenges to society as it could enable ‘digital wildfires’ that can wreak havoc worldwide. While the effects of SMIP have been extensively studied, there is limited understanding of the interplay between two key components of this phenomenon: confirmation bias (reinforcing one’s attitudes and beliefs) and echo chambers (i.e., hear their own voice). This paper addresses this knowledge deficit by exploring how manifestations of confirmation bias contributed to the development of ‘echo chambers’ at the height of the Covid-19 pandemic. Thematic analysis of data collected from 35 participants involved in supply chain information processing forms the basis of a conceptual model of SMIP and four key cross-cutting propositions emerging from the data that have implications for research and practice.},
   language                      = {eng},
}

