@article{PorraLacityParks2020,
   colrev_origin                 = {DBLP.bib/001184;
                                    crossref_jissn_15729419.bib/000535;},
   colrev_status                 = {rev_synthesized},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/000535;;
                                    title:crossref_jissn_15729419.bib/000535;;
                                    year:crossref_jissn_15729419.bib/000535;;
