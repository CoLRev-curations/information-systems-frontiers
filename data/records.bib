@article{001409,
   colrev_origin                 = {crossref_jissn_15729419.bib/001409;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {journal:crossref_jissn_15729419.bib/001409;;
                                    title:crossref_jissn_15729419.bib/001409;;
                                    year:crossref_jissn_15729419.bib/001409;;
                                    author:crossref_jissn_15729419.bib/001409;;
                                    volume:colrev_curation.curation_restrictions;missing;
                                    number:colrev_curation.curation_restrictions;missing;},
   colrev_data_provenance        = {doi:crossref_jissn_15729419.bib/001409;;
                                    abstract:crossref_jissn_15729419.bib/001409;;
                                    language:crossref_jissn_15729419.bib/001409;;
                                    url:crossref_jissn_15729419.bib/001409;;},
   doi                           = {10.1007/S10796-023-10392-8},
   author                        = {Bortlik, Michael and Heinrich, Bernd and Lohninger, Daniel},
   journal                       = {Information Systems Frontiers},
   title                         = {Service Re-Selection for Disruptive Events in Mobile Environments: A Heuristic Technique for Decision Support at Runtime},
   year                          = {2023},
   volume                        = {UNKNOWN},
   number                        = {UNKNOWN},
   url                           = {https://link.springer.com/article/10.1007/s10796-023-10392-8},
   abstract                      = {Modern service-based processes in mobile environments are highly complex due to the necessary spatial–temporal coordination between multiple participating users and the consideration of context information. Due to the dynamic nature of mobile environments, disruptive events occur at runtime, which require a re-selection of the planned service compositions respecting multiple users and context-awareness. Thereby, when re-selecting services the features performance, solution quality, solution robustness and alternative solutions are essential and contribute to the efficacy of service systems. This paper presents an optimization-based heuristic technique based on a stateful representation that uses a region-based approach to re-select services considering multiple users, context information and in particular disruptive events at runtime. The evaluation results, which are based on a real-world scenario from the tourism domain, show that the proposed heuristic is superior compared to competing artifacts.},
   language                      = {eng},
}

@article{AbdallaMikhaeilRamanJamesEtAl2025,
   colrev_origin                 = {crossref_jissn_15729419.bib/001684;},
   colrev_status                 = {md_prepared},
   colrev_masterdata_provenance  = {author:crossref_jissn_15729419.bib/001684;;
                                    journal:crossref_jissn_15729419.bib/001684;;
                                    title:crossref_jissn_15729419.bib/001684;;
                                    year:crossref_jissn_15729419.bib/001684;;
                                    volume:generic_field_requirements;missing;
                                    number:generic_field_requirements;missing;},
   colrev_data_provenance        = {abstract:crossref_jissn_15729419.bib/001684;;
                                    doi:crossref_jissn_15729419.bib/001684;;
                                    language:crossref_jissn_15729419.bib/001684;;
                                    url:crossref_jissn_15729419.bib/001684;;},
   doi                           = {10.1007/S10796-025-10607-0},
   author                        = {Abdalla Mikhaeil, Christine and Raman, Raji and James, Tabitha L. and Venkatesh, Viswanath},
   journal                       = {Information Systems Frontiers},
   title                         = {The Sky is Falling, UTAUT Has Failed! An Investigation of the Adoption of Privacy-Enhancing Technologies (PETs)},
   year                          = {2025},
   volume                        = {UNKNOWN},
   number                        = {UNKNOWN},
   url                           = {https://link.springer.com/article/10.1007/s10796-025-10607-0},
   abstract                      = {In the age of artificial intelligence (AI) and data-hungry applications, privacy-enhancing technologies (PETs) offer a way for individuals to limit data collection and processing by these applications. Yet, the adoption of PETs remains low and user-focused research on adoption predictors is limited. In this work, we use the unified theory of acceptance and use of technology 2 (UTAUT2) to study the adoption of five categories of personal PETs: private browsing, privacy-focused web browsers, privacy browser extensions, secure (encrypted) messaging, and secure (encrypted) email. Our results confirmed the significant role of social influence and habit as predictors of adoption of PETs but also showed that the adoption of these five categories of PETs was not driven by the same set of factors. These differences call for more contextualized research to study the adoption of PETs and raise the potential issue of the limits of the generalizability of UTAUT2. The discovery of the lack of support for such an established theory also creates the potential for breaking new ground through the development of new theories of adoption that are better suited to the emerging world of technologies including PETs.},
   language                      = {eng},
}

