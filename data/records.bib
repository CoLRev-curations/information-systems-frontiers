                                    volume:generic_field_requirements;missing;
                                    number:generic_field_requirements;missing;},
   colrev_data_provenance        = {abstract:crossref_jissn_15729419.bib/001781;;
                                    doi:crossref_jissn_15729419.bib/001781;;
                                    language:crossref_jissn_15729419.bib/001781;;
                                    url:crossref_jissn_15729419.bib/001781;;},
   doi                           = {10.1007/S10796-024-10567-X},
   author                        = {Obayi, Raymond and Choudhary, Sonal and Nayak, Rakesh and GV, Ramanjaneyulu},
   journal                       = {Information Systems Frontiers},
   title                         = {Pragmatic Interoperability for Human–Machine Value Creation in Agri-Food Supply Chains},
   year                          = {2025},
   volume                        = {UNKNOWN},
   number                        = {UNKNOWN},
   url                           = {https://link.springer.com/article/10.1007/s10796-024-10567-x},
   abstract                      = {This study delves into the dynamics of pragmatic interoperability, focusing on the case of a digital ecosystem in India —the eKrishi platform—which combines of industry 4.0 technologies with human-centric principles. Through qualitative analysis, we unveil the motivations shaping system and business-level interoperability alignment. We found that three categories of sustainability metrics—socio-economic, socio-ecological, and eco-efficiency— are driven by diverse pragmatic views. Furthermore, we found that system-level alignment is driven by actors’ defensive strategy for compliance and standardization, while business level interoperability is underpinned by actors’ offensive strategy for social and economic innovation. The study introduces a 2 × 2 alignment framework—corporate citizenship, regulatory stewardship, corporate stewardship, and value chain stewardship—offering nuanced insights. By aligning systems and business motives for pragmatic interoperability, we contribute towards theory building on interoperability and provide practical implications for guiding stakeholder alignment in Industry 4.0 initiatives.},
   language                      = {eng},
}

