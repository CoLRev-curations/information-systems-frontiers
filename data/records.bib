                                    year:crossref_jissn_15729419.bib/001705;;
                                    volume:generic_field_requirements;missing;
                                    number:generic_field_requirements;missing;},
   colrev_data_provenance        = {abstract:crossref_jissn_15729419.bib/001705;;
                                    doi:crossref_jissn_15729419.bib/001705;;
                                    language:crossref_jissn_15729419.bib/001705;;
                                    url:crossref_jissn_15729419.bib/001705;;},
   doi                           = {10.1007/S10796-025-10619-W},
   author                        = {Kulkarni, Rakesh Suresh and Krishnan, Satish and Sebastian, M. P.},
   journal                       = {Information Systems Frontiers},
   title                         = {A Dynamic Perspective to Drive Digital Servitization: A Meta-Synthesis Approach to Understand Interactions Between Key Factors},
   year                          = {2025},
   volume                        = {UNKNOWN},
   number                        = {UNKNOWN},
   url                           = {https://link.springer.com/article/10.1007/s10796-025-10619-w},
   abstract                      = {The present study aims to establish a dynamic perspective of how the choice of attributes driving digital servitization (DS) and their interaction with each other contributes to the success of DS endeavors in firms. This study conducts a meta-synthesis of qualitative studies on DS, incorporating study-specific analysis followed by a cross-study synthesis. Utilizing the social exchange theory, it presents a framework that defines present and future firm configurations and guides transitions in the DS journey. This study bridges gaps in prior research on DS by providing a dynamic, theory-based perspective using meta-synthesis on how firms must evolve their attributes and capabilities to attain desired states in their transformation journey. The framework developed from this study provides practitioners with paths or sequences of decisions that a firm should follow over time to transition from one configuration to another for a firm’s success in DS.},
   language                      = {eng},
}

